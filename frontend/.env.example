# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Application Configuration
NEXT_PUBLIC_APP_NAME=CHTHSHOP
NEXT_PUBLIC_APP_VERSION=1.0.0

# Features Flags
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PWA=false

# External Services (when implemented)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# File Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Social Links
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/merchcraft
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/merchcraft
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/merchcraft

# Development
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_MOCK_API=false
