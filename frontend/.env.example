# Where the backend runs, as reached from the Next.js server (used by the /api proxy).
BACKEND_URL=http://localhost:5000

# Optional: call a backend on another origin directly instead of through the proxy.
# NEXT_PUBLIC_API_URL=https://api.example.com/api

# Optional: Telegram Mini App link (https://t.me/<bot>/<app name>) for share links and TON Connect returns.
# NEXT_PUBLIC_TELEGRAM_MINI_APP_LINK=https://t.me/chth_bot/shop
