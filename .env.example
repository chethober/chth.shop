# Settings for `docker compose up`. Copy to .env and fill in.
# (For running without Docker, use backend/.env and frontend/.env instead.)

# Required: long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=
SESSION_SECRET=

# Public URL(s) of the site, comma-separated; the first is the default.
FRONTEND_URL=http://localhost:3000
# Host port the site is published on.
FRONTEND_PORT=3000

# PostgreSQL (only reachable inside the compose network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merch_platform

# Sign-in providers (Google and Telegram)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Telegram Mini App: the HTTPS site the bot opens (default: first FRONTEND_URL), the app short
# name from @BotFather /newapp, and a random secret for the bot webhook.
TELEGRAM_MINI_APP_URL=
TELEGRAM_MINI_APP_NAME=
TELEGRAM_WEBHOOK_SECRET=

# Crypto payments via NOWPayments (https://account.nowpayments.io): API key + IPN secret.
# The IPN webhook is <PUBLIC_API_URL>/payments/webhook/nowpayments.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Public URL of the API for payment webhooks; defaults to <first FRONTEND_URL>/api.
PUBLIC_API_URL=
# Share of each sale's margin (price minus production cost) the platform keeps.
PLATFORM_FEE_PERCENT=25

# TON (TON Connect wallet payments + NFT certificates). `testnet` for trying things out.
TON_NETWORK=mainnet
# Wallet that receives TON payments; enables "Pay with TON wallet" at checkout.
TON_RECEIVER_ADDRESS=
# Optional, raises toncenter rate limits (https://t.me/tonapibot).
TONCENTER_API_KEY=
# Fixed TON price in USD; leave empty to use the live CoinGecko price.
TON_USD_PRICE=
# Platform hot wallet (v4, 24 words): mints NFT certificates and sends USDT payouts.
# Keep only what you need for a month of payouts + mint fees in it.
TON_WALLET_MNEMONIC=
TON_NFT_COLLECTION_ADDRESS=
# USDT jetton master; defaults to Tether's mainnet USDT. Set a test jetton on testnet.
TON_USDT_MASTER=

# Seller payouts (USDT): days after payment before earnings are payable, and the minimum.
PAYOUT_HOLD_DAYS=14
PAYOUT_MIN_USD=10

# Referrals: discount for the invited customer's first order, and the referrer's credit.
REFERRAL_DISCOUNT_PERCENT=10
REFERRAL_REWARD_PERCENT=5

# Frontend build: the Mini App link https://t.me/<bot>/<app name> (share links, TON Connect returns).
TELEGRAM_MINI_APP_LINK=
