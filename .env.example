# Settings for `docker compose up`. Copy to .env and fill in.
# (For running without Docker, use backend/.env and frontend/.env instead.)

# Required: long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=
SESSION_SECRET=

# Public URL(s) of the site, comma-separated; the first is the default.
# Local HTTPS (needed for Telegram): install mkcert, run `mkcert -install`, then from the repo root
#   mkcert -cert-file certs/localhost.pem -key-file certs/localhost-key.pem localhost 127.0.0.1 ::1
# and use https://localhost:3000 here. Without the certs the site is served over plain HTTP.
FRONTEND_URL=https://localhost:3000
# Host port the site is published on.
FRONTEND_PORT=3000

# PostgreSQL (only reachable inside the compose network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=merch_platform

# Optional sign-in providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X: developer portal → app → User authentication settings (OAuth 2.0, Web App).
#   Callback URI: <FRONTEND_URL>/api/auth/x/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Telegram OpenID Connect: @BotFather mini app → your bot → Login Widget.
#   Allowed URLs: <FRONTEND_URL> and <FRONTEND_URL>/api/auth/telegram/callback (HTTPS only)
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Optional: website order alerts through the artist bot (bot API token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=6330862227

# Optional HTTP proxy the API uses to reach X/Telegram when the network blocks them,
# e.g. http://host.docker.internal:1080 for a proxy on this machine (it must listen on an
# address containers can reach, such as 172.17.0.1 or 0.0.0.0 — not only 127.0.0.1).
OUTBOUND_PROXY=

# Optional: CHTH hub reporting (new orders, sign-ups, errors) and the signed /api/internal routes
# the hub calls for stats and order buttons. Leave empty to switch it off.
HUB_URL=
HUB_SECRET=
SHOP_CURRENCY=USD
