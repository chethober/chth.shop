generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  password     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  googleId     String?  @unique
  telegramId   String?  @unique
  authProvider String?  @default("google")
  isGoogleUser Boolean  @default(false)
  isSeller     Boolean  @default(false)
  role         UserRole @default(CUSTOMER)
  store        Store?
  cart         Cart?
  orders       Order[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

/// A seller on the marketplace: an artist selling their art, or a merchant selling their brand.
model Store {
  id        String    @id @default(uuid())
  userId    String    @unique
  kind      StoreKind @default(ARTIST)
  bio       String?
  storeName String?
  instagram String?
  twitter   String?
  tiktok    String?
  youtube   String?
  spotify   String?
  telegram  String?
  discord   String?
  website   String?
  /// Crypto address payouts are sent to.
  payoutAddress String?
  /// Network of `payoutAddress`, e.g. "USDT-TRC20" or "TON".
  payoutNetwork String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  sales     OrderItem[]

  @@map("stores")
}

enum StoreKind {
  ARTIST
  MERCHANT
}

model Product {
  id           String      @id @default(uuid())
  name         String
  description  String?
  /// Catalog base product (tshirt, hoodie, pants, mug, hat, tote).
  type         String
  price        Float       @default(0)
  imageUrl     String?
  /// Colors (hex) and sizes the buyer can pick from; empty means the catalog defaults.
  colors       String[]    @default([])
  sizes        String[]    @default([])
  /// Whether buyers may add their own text / artwork on top of the seller's design.
  customizable Boolean     @default(false)
  /// The seller's 3D studio design (garment color and decoration layers).
  design       Json?
  isActive     Boolean     @default(true)
  storeId      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  cartItems    CartItem[]
  orderItems   OrderItem[]
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([type])
  @@map("products")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  /// Null for a buyer's own design made from a catalog blank.
  productId  String?
  /// Catalog base product; always set.
  type       String
  /// Size, color, and personalization chosen by the buyer.
  options    Json     @default("{}")
  /// Stable hash of `options`, so identical configurations stack.
  optionsKey String   @default("")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  productId     String?
  storeId       String?
  type          String
  name          String
  options       Json     @default("{}")
  quantity      Int
  /// Unit price charged to the buyer.
  price         Float
  /// Unit production cost from the catalog at order time.
  baseCost      Float    @default(0)
  /// Total the seller earns for this line (after production cost and platform fee).
  sellerEarning Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  store         Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("order_items")
}

model Order {
  id                String        @id @default(uuid())
  userId            String
  status            OrderStatus   @default(PENDING)
  total             Float
  currency          String        @default("USD")
  shippingAddress   String?
  paymentStatus     PaymentStatus @default(UNPAID)
  paymentProvider   String?
  /// Provider's invoice / payment id.
  paymentId         String?
  paymentUrl        String?
  /// Crypto the buyer actually paid with, as reported by the provider.
  payCurrency       String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  WAITING
  CONFIRMING
  PAID
  PARTIALLY_PAID
  EXPIRED
  FAILED
  REFUNDED
}
