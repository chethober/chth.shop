# Server
PORT=5000
NODE_ENV=development
# Frontend origin(s) users are redirected back to after sign-in, comma-separated.
# The first is the default. In development any private-network host (e.g. your LAN IP) is also allowed.
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL, used by Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/merch_platform"

# Secrets (required when NODE_ENV=production)
JWT_SECRET=change-me
SESSION_SECRET=change-me

# Rate limiting (production only)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OAuth callbacks are built from the site origin: <origin>/api/auth/google/callback
# and <origin>/api/auth/x/callback. Register one per origin you sign in from.

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter) OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Telegram Login Widget
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
