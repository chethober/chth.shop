# Server
PORT=5000
NODE_ENV=development
# Frontend origin(s) users are redirected back to after sign-in, comma-separated.
# The first is the default. In development any private-network host (e.g. your LAN IP) is also allowed.
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL, used by Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/merch_platform"

# Secrets (required when NODE_ENV=production)
JWT_SECRET=change-me
SESSION_SECRET=change-me

# Rate limiting (production only)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OAuth callbacks are built from the site origin: <origin>/api/auth/google/callback
# <origin>/api/auth/x/callback and <origin>/api/auth/telegram/callback.
# Register one per origin you sign in from.

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter) OAuth 2.0 — developer portal → app → User authentication settings
# (Type of App: Web App). Callback URI: <origin>/api/auth/x/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Telegram OpenID Connect — @BotFather mini app → your bot → Login Widget.
# Allowed URLs: <origin> and <origin>/api/auth/telegram/callback (HTTPS only)
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Optional: website order alerts through the artist bot (bot API token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Optional: CHTH hub reporting and the signed /api/internal routes (see README).
HUB_URL=
HUB_SECRET=
SHOP_CURRENCY=USD
# Telegram Mini App: the HTTPS site the bot opens (default: first FRONTEND_URL), the app short
# name from @BotFather /newapp, and a random secret for the bot webhook.
TELEGRAM_MINI_APP_URL=
TELEGRAM_MINI_APP_NAME=
TELEGRAM_WEBHOOK_SECRET=

# Crypto payments. `mock` (the default outside production) adds a "simulate payment" page;
# production requires `nowpayments` with an API key and IPN secret.
PAYMENT_PROVIDER=mock
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Public URL of this API for payment webhooks; defaults to <first FRONTEND_URL>/api.
PUBLIC_API_URL=

# Share of each sale's margin (price minus production cost) the platform keeps.
PLATFORM_FEE_PERCENT=25

# TON (TON Connect wallet payments + NFT certificates). `testnet` for trying things out.
TON_NETWORK=mainnet
# Wallet that receives TON payments; enables "Pay with TON wallet" at checkout.
TON_RECEIVER_ADDRESS=
# Optional, raises toncenter rate limits (https://t.me/tonapibot).
TONCENTER_API_KEY=
# Fixed TON price in USD; leave empty to use the live CoinGecko price.
TON_USD_PRICE=
# Platform hot wallet (v4, 24 words): mints NFT certificates and sends USDT payouts.
# Keep only what you need for a month of payouts + mint fees in it.
TON_WALLET_MNEMONIC=
TON_NFT_COLLECTION_ADDRESS=
# USDT jetton master; defaults to Tether's mainnet USDT. Set a test jetton on testnet.
TON_USDT_MASTER=

# Seller payouts (USDT): days after payment before earnings are payable, and the minimum.
PAYOUT_HOLD_DAYS=14
PAYOUT_MIN_USD=10

# Referrals: discount for the invited customer's first order, and the referrer's credit.
REFERRAL_DISCOUNT_PERCENT=10
REFERRAL_REWARD_PERCENT=5
