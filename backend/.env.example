# Server
PORT=5000
NODE_ENV=development
# Frontend origin(s) users are redirected back to after sign-in, comma-separated.
# The first is the default. In development any private-network host (e.g. your LAN IP) is also allowed.
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL, used by Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/merch_platform"

# Secrets (required when NODE_ENV=production)
JWT_SECRET=change-me
SESSION_SECRET=change-me

# Rate limiting (production only)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OAuth callbacks are built from the site origin: <origin>/api/auth/google/callback.
# Register one per origin you sign in from.

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login Widget
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Crypto payments. `mock` (the default outside production) adds a "simulate payment" page;
# production requires `nowpayments` with an API key and IPN secret.
PAYMENT_PROVIDER=mock
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Public URL of this API for payment webhooks; defaults to <first FRONTEND_URL>/api.
PUBLIC_API_URL=

# Share of each sale's margin (price minus production cost) the platform keeps.
PLATFORM_FEE_PERCENT=25
